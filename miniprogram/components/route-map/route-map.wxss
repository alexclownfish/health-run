:host { display: block; }
.map-shell { position: relative; overflow: hidden; width: 100%; height: 380rpx; border-radius: 13rpx; background: #e2ece6; }
.route-map { position: absolute; inset: 0; width: 100%; height: 100%; }
.map-badge { position: absolute; z-index: 3; left: 18rpx; bottom: 18rpx; padding: 7rpx 12rpx; border: 1rpx solid rgba(0,93,70,.1); border-radius: 8rpx; color: #49685d; background: rgba(255,255,255,.9); font-size: 17rpx; }
.map-compass { position: absolute; z-index: 3; top: 20rpx; right: 20rpx; width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(0,93,70,.1); border-radius: 50%; color: #005d46; background: rgba(255,255,255,.92); box-shadow: 0 5rpx 16rpx rgba(0,70,50,.1); }
.map-compass text { font-size: 20rpx; transform: rotate(18deg); }
