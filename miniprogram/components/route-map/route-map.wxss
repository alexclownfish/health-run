:host { display: block; }
.map-shell { position: relative; overflow: hidden; width: 100%; height: 380rpx; border-radius: 13rpx; background: #f1edf5; }
.route-map { position: absolute; inset: 0; width: 100%; height: 100%; }
.map-badge { position: absolute; z-index: 3; left: 18rpx; bottom: 18rpx; padding: 7rpx 12rpx; border: 1rpx solid rgba(63,75,159,.12); border-radius: 8rpx; color: #625a6b; background: rgba(255,255,255,.9); font-size: 17rpx; }
.map-compass { position: absolute; z-index: 3; top: 20rpx; right: 20rpx; width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(63,75,159,.12); border-radius: 50%; color: #3f4b9f; background: rgba(255,255,255,.92); box-shadow: 0 5rpx 16rpx rgba(63,75,159,.12); }
.map-compass text { font-size: 20rpx; transform: rotate(18deg); }
