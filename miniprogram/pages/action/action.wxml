<view class="page action-page with-fixed-action">
  <view class="checkpoint-bar">
    <view><view class="status-dot"></view><text class="mono">PATCH_0{{station.id}} / POINT VERIFIED</text></view>
    <text>✓</text>
  </view>

  <view class="motion-card motion-{{stationIndex}}">
    <image class="action-guide-image" src="/assets/action-guide-reference.png" mode="widthFix" />
  </view>

  <view class="instruction">
    <text class="eyebrow">0{{station.id}} / 保持站立</text>
    <text class="instruction-title">{{station.heading}}</text>
    <text class="instruction-copy">{{station.instruction}}</text>
  </view>

  <view class="timer-card card">
    <text class="timer-text mono">{{timerText}}</text>
    <button class="timer-button {{timerComplete ? 'complete' : ''}}" bindtap="toggleTimer" disabled="{{timerComplete}}">
      <text>{{timerComplete ? '✓' : timerRunning ? 'Ⅱ' : actionStarted ? '▷' : '▶'}}</text>
      <text>{{timerComplete ? '动作完成' : timerRunning ? '暂停' : actionStarted ? '继续动作' : '开始动作'}}</text>
    </button>
  </view>

  <view class="safety-card">
    <view class="safety-icon">♢</view>
    <view><text>安全提示</text><text>{{station.safety}}</text></view>
  </view>

  <view class="fixed-action">
    <button class="primary-button" disabled="{{!actionComplete}}" bindtap="goUpload"><text>{{actionComplete ? '动作完成，去拍照' : '先完成动作计时'}}</text><text class="arrow">⌁</text></button>
  </view>
</view>
