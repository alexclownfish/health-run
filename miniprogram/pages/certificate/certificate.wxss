.certificate-page { padding-top: 18rpx; }
.certificate { overflow: hidden; }
.certificate-top { position: relative; overflow: hidden; min-height: 260rpx; padding: 38rpx 36rpx; color: #fff; background: var(--green); }
.certificate-code { position: relative; z-index: 2; display: block; color: var(--lime); font-size: 17rpx; }
.certificate-title { position: relative; z-index: 2; display: block; margin-top: 30rpx; font-size: 34rpx; font-weight: 800; }
.certificate-subtitle { position: relative; z-index: 2; display: block; margin-top: 9rpx; color: #c7eadd; font-size: 19rpx; }
.complete-seal { position: absolute; z-index: 2; top: 85rpx; right: 40rpx; width: 100rpx; height: 100rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--green); background: #fff; font-size: 53rpx; font-weight: 700; }
.decor { position: absolute; border-radius: 50%; background: rgba(168,238,36,.16); }
.decor-one { left: -90rpx; bottom: -80rpx; width: 270rpx; height: 180rpx; }.decor-two { right: -20rpx; top: -120rpx; width: 270rpx; height: 220rpx; }
.certificate-body { padding: 42rpx 36rpx 27rpx; text-align: center; }
.certificate-id { color: var(--green); font-size: 19rpx; }
.certificate-owner { display: block; margin-top: 12rpx; font-size: 21rpx; font-weight: 700; }
.score { margin: 34rpx 0; }
.score text { display: block; }
.score text:first-child { font-family: monospace; font-size: 82rpx; font-weight: 600; line-height: 1; }
.score text:last-child { margin-top: 14rpx; font-size: 31rpx; font-weight: 800; }
.certificate-stations { display: grid; gap: 15rpx; padding: 23rpx; border-radius: 16rpx; background: #edf6f1; text-align: left; }
.certificate-stations > view { display: grid; grid-template-columns: 40rpx 1fr auto; gap: 14rpx; align-items: center; font-size: 18rpx; }
.station-dot { width: 39rpx; height: 39rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--deep); background: var(--lime-soft); font-family: monospace; font-size: 16rpx; }
.certificate-stations > view > text:last-child { color: var(--green); font-size: 16rpx; font-weight: 700; }
.certificate-note { display: block; margin: 33rpx 0 15rpx; color: var(--muted); font-size: 17rpx; }
.certificate-meta { display: flex; justify-content: center; gap: 28rpx; color: var(--green); font-size: 18rpx; }
.certificate-meta > text > text { font-weight: 700; }
.certificate-footer { margin-top: 29rpx; padding-top: 22rpx; border-top: 1rpx solid var(--line); color: #85978f; font-size: 14rpx; }
.certificate-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 20rpx; }
.back-home { margin-top: 18rpx; }
.empty-certificate { padding: 100rpx 50rpx; text-align: center; }
.empty-icon { width: 120rpx; height: 120rpx; display: flex; align-items: center; justify-content: center; margin: 0 auto 30rpx; border-radius: 50%; color: var(--green); background: var(--mint); font-size: 53rpx; }
.empty-certificate text { display: block; }
.empty-certificate > text:nth-child(2) { font-size: 35rpx; font-weight: 800; }
.empty-certificate > text:last-child { margin-top: 13rpx; color: var(--muted); font-size: 21rpx; line-height: 1.7; }
.certificate-canvas { position: fixed; z-index: -1; left: -2000rpx; top: 0; width: 750rpx; height: 1100rpx; opacity: 0; pointer-events: none; }
