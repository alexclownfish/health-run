<view class="page records-page">
  <view class="page-heading"><text class="eyebrow">ACTIVITY LOG</text><text class="page-title">运动记录</text></view>

  <view class="week-summary">
    <view class="summary-copy"><text>本周健康能量</text><text>{{stats.energy}}</text><text class="mono">ENERGY POINTS</text></view>
    <view class="energy-ring" style="--percent: {{progressStyle}};"><view><text>{{stats.percent}}%</text></view></view>
  </view>

  <view class="metric-grid">
    <view class="card"><text class="metric-icon">⌁</text><text class="metric-value mono">{{stats.distance}}</text><text class="metric-label">累计公里</text></view>
    <view class="card"><text class="metric-icon">♨</text><text class="metric-value mono">{{stats.calories}}</text><text class="metric-label">活力消耗</text></view>
    <view class="card"><text class="metric-icon">✓</text><text class="metric-value mono">{{stats.points}}</text><text class="metric-label">完成点位</text></view>
  </view>

  <view class="calendar card">
    <view class="section-head calendar-head"><view><text class="section-kicker">AUGUST</text><text class="section-title">本月节奏</text></view><text class="section-side">2026.08</text></view>
    <view class="week-labels"><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text></view>
    <view class="week-days"><text>3</text><text class="today">4<view></view></text><text>5</text><text>6</text><text>7</text><text>8</text><text>9</text></view>
  </view>

  <view class="section-head"><view><text class="section-kicker">RECENT</text><text class="section-title">最近活动</text></view></view>
  <view class="history-list">
    <view wx:for="{{recentActivities}}" wx:key="title" class="history-item">
      <view class="history-date"><text>{{item.day}}</text><text>{{item.month}}</text></view>
      <view class="history-copy"><text>{{item.title}}</text><text>{{item.detail}}</text></view>
      <text class="history-status">{{item.status}}</text>
    </view>
  </view>
</view>
