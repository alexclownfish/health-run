.route-page { padding-top: 18rpx; }
.route-heading { display: flex; align-items: center; justify-content: space-between; }
.route-heading .page-title { display: block; }
.profile-dot { overflow: hidden; width: 70rpx; height: 70rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--deep); background: var(--lavender); font-size: 24rpx; font-weight: 800; }
.profile-dot image { width: 100%; height: 100%; }
.weather { display: grid; grid-template-columns: 72rpx 1fr auto; gap: 18rpx; align-items: center; margin-top: 26rpx; padding: 18rpx 22rpx; }
.weather-symbol { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #b8661d; background: var(--peach); font-size: 35rpx; }
.weather-copy text { display: block; }
.weather-copy text:first-child { font-size: 25rpx; font-weight: 700; }
.weather-copy text:last-child { margin-top: 5rpx; color: var(--muted); font-size: 19rpx; }
.weather-score { padding-left: 22rpx; border-left: 1rpx solid var(--line); text-align: right; }
.weather-score text { display: block; }
.weather-score text:first-child { color: var(--orange); font-family: monospace; font-size: 31rpx; }
.weather-score text:last-child { margin-top: 4rpx; color: var(--muted); font-size: 17rpx; }
.challenge { position: relative; overflow: hidden; min-height: 196rpx; display: flex; justify-content: space-between; margin-top: 22rpx; padding: 34rpx 30rpx; border-radius: 18rpx; color: #fff; background: var(--orange); }
.challenge-copy { position: relative; z-index: 2; }
.challenge-code { display: block; color: var(--yellow); font-size: 17rpx; }
.challenge-title { display: block; margin-top: 20rpx; font-size: 34rpx; font-weight: 800; }
.challenge-desc { display: block; margin-top: 9rpx; color: #fff0e4; font-size: 19rpx; }
.challenge-time { position: relative; z-index: 2; padding-top: 44rpx; text-align: right; }
.challenge-time text { display: block; }
.challenge-time text:first-child { color: var(--yellow); font-family: monospace; font-size: 31rpx; font-weight: 600; }
.challenge-time text:last-child { margin-top: 5rpx; color: #fff0e4; font-size: 17rpx; }
.challenge-ring { position: absolute; border: 40rpx solid rgba(255,211,78,.18); border-radius: 50%; }
.ring-one { right: -100rpx; bottom: -170rpx; width: 330rpx; height: 330rpx; }
.ring-two { right: 80rpx; top: -100rpx; width: 170rpx; height: 170rpx; }
.route-card { overflow: hidden; margin-top: 22rpx; }
.route-card-head { display: flex; align-items: flex-end; justify-content: space-between; padding: 25rpx 27rpx 20rpx; }
.route-card-title { display: block; margin-top: 5rpx; font-size: 31rpx; font-weight: 800; }
.map { overflow: hidden; height: 380rpx; margin: 0 18rpx; border-radius: 13rpx; background: #f1edf5; }
.map-hint { display: flex; align-items: center; justify-content: center; gap: 11rpx; padding: 22rpx; color: var(--muted); font-size: 19rpx; }
.scan-icon { color: var(--orange); font-size: 27rpx; }
.demo-link { color: var(--orange); font-size: 20rpx; }
.station-list { display: grid; gap: 16rpx; }
.station-card { display: grid; grid-template-columns: 72rpx 1fr auto; gap: 18rpx; align-items: center; padding: 20rpx 22rpx; box-shadow: none; }
.station-card.locked { opacity: .48; }
.station-number { width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--ink); background: var(--yellow); font-family: monospace; font-size: 21rpx; }
.station-card.done .station-number { color: #fff; background: var(--deep); }
.station-copy text, .station-meta text { display: block; }
.station-copy text:first-child { font-size: 26rpx; font-weight: 700; }
.station-copy text:last-child { margin-top: 6rpx; color: var(--muted); font-size: 18rpx; }
.station-meta { text-align: right; }
.station-meta text:first-child { color: var(--orange); font-family: monospace; font-size: 17rpx; font-weight: 600; }
.station-meta text:last-child { margin-top: 7rpx; color: var(--muted); font-size: 17rpx; }
